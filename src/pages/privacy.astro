---
import Base from '../layouts/Base.astro';
---
<Base title="Privacy" description="How CallChrist handles your information.">
  <article class="wrap prose" style="padding-top:3rem">
    <h1>Privacy</h1>
    <p>
      CallChrist uses Cloudflare Web Analytics, which counts visits without cookies and without tracking you across
      other websites.
    </p>
    <p>
      If you sign up for the daily email, we store your email address with our email provider only to send you that
      email. We never sell or share it. Every email has an unsubscribe link.
    </p>
    <p>Questions? Contact us at hello@callchrist.com.</p>
    <p><em>Last updated: November 2026.</em></p>
  </article>
</Base>
