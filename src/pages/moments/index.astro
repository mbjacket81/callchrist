---
import Base from '../../layouts/Base.astro';
import MomentGrid from '../../components/MomentGrid.astro';
---
<Base
  title="Bible verses and prayers for hard moments"
  description="Find scripture and a prayer for what you're facing right now: anxiety, grief, fear, loneliness, sickness, job loss, and more."
>
  <div class="wrap-wide" style="padding-top:3rem">
    <h1>What are you facing?</h1>
    <p class="opening">Choose the moment closest to yours. Each page has scripture and a prayer you can pray right now.</p>
    <MomentGrid />
  </div>
</Base>
